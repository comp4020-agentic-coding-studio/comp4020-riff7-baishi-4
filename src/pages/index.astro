---
import { currentTutorAgent } from "../lib/auth";
import { listRoster, listWeeks, sessionDate } from "../lib/db";
import "../styles.css";

const roster = listRoster();
const weeks = listWeeks();
const error = Astro.url.searchParams.get("error");
const DAYS = ["Mon", "Tue", "Wed", "Thu", "Fri"];

// The weekly timetable reuses the same roster rows the group list and the
// reschedule form already fetch — no separate schedule data to keep in sync.
const startTimes = [...new Set(roster.map((g) => g.startTime))].sort();
const tutorCount = new Set(roster.map((g) => g.tutorName)).size;

// No login system yet — see src/lib/auth.ts. Every permission check below
// reads through the same function the server routes do, so the UI's "yours
// vs read-only" split can never drift from what the server will actually
// accept.
const tutorAgent = currentTutorAgent();
const currentGroup = roster.find((g) => g.agent === tutorAgent);
const ownExceptions = currentGroup?.sessions.filter((s) => s.exceptionId !== null) ?? [];

// The reschedule form's date input is bounded to real teaching days so a
// tutor can't pick a date the server will just reject.
const teachingDates = weeks.flatMap((w) => DAYS.map((day) => sessionDate(w.monday, day))).sort();
const minDate = teachingDates[0];
const maxDate = teachingDates[teachingDates.length - 1];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="This course's crit-group roster: standing weekly slots and per-week reschedule exceptions, persisted in SQLite and live-synced across tabs."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Crit roster</title>
  </head>
  <body>
    <nav aria-label="site">
      <span class="brand">Crit roster</span>
      <div class="nav-links">
        <a href="/">Roster</a>
        <a href="/readme/">About</a>
      </div>
    </nav>
    <main>
      <header class="hero">
        <p class="eyebrow">COMP4020 · crit groups</p>
        <h1>Crit roster</h1>
        <p class="lede">
          Every crit group's standing weekly slot, and the exceptions that
          replace it for one teaching week at a time.
        </p>
        <p class="hero-note">
          Rescheduling here writes a row to SQLite instead of hand-editing the
          course website's <code>api/crit-groups.json</code>. Open this page
          in two tabs: rescheduling in one updates the other over the live
          stream.
        </p>
      </header>

      {error && <p class="error" role="alert">{error}</p>}
      <p id="stale-notice" class="notice" role="status" hidden>
        The roster changed in another tab. Your draft below is untouched —
        reload when you're ready to see the update.
      </p>

      <ul class="facts" aria-label="At a glance">
        <li><strong>{roster.length}</strong><span>crit groups</span></li>
        <li><strong>{weeks.length}</strong><span>teaching weeks</span></li>
        <li><strong>{tutorCount}</strong><span>tutors</span></li>
        <li><strong>Live</strong><span>synced across tabs</span></li>
      </ul>

      {currentGroup && (
        <div class="card you-panel">
          <p class="you-eyebrow">Signed in as</p>
          <p class="you-line">
            <strong>{currentGroup.tutorName}</strong> · tutoring{" "}
            <a href={`#group-${currentGroup.agent}`}>{currentGroup.name}</a>
          </p>
          <p class="you-slot">
            Standing slot: every {currentGroup.day} {currentGroup.startTime}–{currentGroup.endTime} ·{" "}
            {currentGroup.room}
            {ownExceptions.length > 0 && <> · {ownExceptions.length} rescheduled this semester</>}
          </p>
          <a class="btn btn-ghost you-link" href={`#group-${currentGroup.agent}`}>
            View your sessions →
          </a>
        </div>
      )}

      <h2 id="timetable-heading">Weekly timetable</h2>
      <p class="section-lede">
        Every group's standing slot at a glance — pick a slot to jump to its
        details and any week-by-week changes below.
      </p>
      <div class="timetable-scroll">
        <table aria-labelledby="timetable-heading">
          <caption class="sr-only">Crit groups by day and time</caption>
          <thead>
            <tr>
              <th scope="col">Time</th>
              {DAYS.map((day) => <th scope="col">{day}</th>)}
            </tr>
          </thead>
          <tbody>
            {startTimes.map((startTime) => (
              <tr>
                <th scope="row">{startTime}</th>
                {DAYS.map((day) => {
                  const cellGroups = roster.filter((g) => g.day === day && g.startTime === startTime);
                  return (
                    <td>
                      {cellGroups.map((g) => (
                        <a class={`slot ${g.agent === tutorAgent ? "slot-mine" : ""}`} href={`#group-${g.agent}`}>
                          <span class="slot-name">
                            {g.name}
                            {g.agent === tutorAgent && <span class="slot-you-tag"> Yours</span>}
                          </span>
                          <span class="slot-time">{g.startTime}–{g.endTime}</span>
                          <span class="slot-meta">{g.tutorName}</span>
                        </a>
                      ))}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 id="groups-heading">Crit groups</h2>
      <p class="section-lede">
        Each group's standing slot, plus any exceptions on file for a single
        teaching week.
      </p>
      <div class="group-grid" aria-labelledby="groups-heading">
        {
          roster.map((group) => {
            const exceptionSessions = group.sessions.filter((s) => s.exceptionId !== null);
            const isMine = group.agent === tutorAgent;
            return (
              <section
                class={`card group-card ${isMine ? "group-card-mine" : ""}`}
                id={`group-${group.agent}`}
                aria-labelledby={`group-heading-${group.agent}`}
              >
                <div class="group-card-head">
                  <h3 id={`group-heading-${group.agent}`}>{group.name}</h3>
                  {isMine && <span class="badge">Your group</span>}
                </div>
                <p class="standing-slot">
                  Standing slot: every {group.day} {group.startTime}–{group.endTime} ·{" "}
                  {group.tutorName} · {group.room}
                </p>
                {exceptionSessions.length === 0 ? (
                  <p class="no-exceptions">No exceptions this semester — meets at its standing slot every teaching week.</p>
                ) : (
                  <ul class="exceptions">
                    {exceptionSessions.map((session) => (
                      <li data-exception-id={session.exceptionId}>
                        <div class="exception-head">
                          <span class="badge">Week {session.week}</span>
                          <span class="exception-date">{session.date}</span>
                        </div>
                        <p class="exception-detail">
                          Now {session.day} {session.startTime}–{session.endTime} in {session.room} —{" "}
                          {session.reason}
                        </p>
                        {isMine && (
                          <form method="post" action={`/api/exceptions/${session.exceptionId}/cancel`}>
                            <button type="submit" class="btn btn-ghost">Cancel, back to standing slot</button>
                          </form>
                        )}
                      </li>
                    ))}
                  </ul>
                )}
                {!isMine && <p class="view-only-note">View-only — managed by {group.tutorName}.</p>}
              </section>
            );
          })
        }
      </div>

      {currentGroup && (
        <div class="card form-card">
          <form method="post" action="/api/exceptions">
            <fieldset>
              <legend>Reschedule {currentGroup.name}'s session</legend>
              <input type="hidden" name="critGroupId" value={currentGroup.id} />

              <div class="field">
                <label for="date">Date</label>
                <input id="date" name="date" type="date" min={minDate} max={maxDate} required />
              </div>

              <div class="field">
                <label for="startTime">Start time</label>
                <input id="startTime" name="startTime" type="time" required />
                <span class="end-preview" id="end-preview" aria-live="polite"></span>
              </div>

              <div class="field">
                <label for="room">Room</label>
                <input id="room" name="room" type="text" placeholder="defaults to the group's usual room" />
              </div>

              <div class="field field-wide">
                <label for="reason">Reason</label>
                <input id="reason" name="reason" type="text" required />
              </div>

              <p class="field-hint field-wide">
                Sessions always run 90 minutes — the end time is calculated automatically (e.g. 10:00 → 11:30). Only{" "}
                {currentGroup.name}'s sessions can be rescheduled here; every other group is view-only above.
              </p>

              <button type="submit" class="btn btn-primary">Reschedule</button>
            </fieldset>
          </form>
        </div>
      )}
    </main>
    <script>
      import { createDirtyTracker, createReconnectGate } from "../lib/live-reload";

      // The live half of the roster: reload on any change reported over the
      // SSE stream, so a tutor watching this page sees a reschedule made in
      // another tab without acting themselves. The form itself needs none of
      // this — its POST + redirect re-renders the submitting tab from
      // SQLite; this stream is how every other tab finds out.
      //
      // But a bare reload is only safe when there's nothing to lose: if this
      // tutor is mid-way through filling in their own reschedule, the same
      // reload that shows someone else's change would silently wipe their
      // draft too. Track that with the reschedule form's own `input` event
      // and skip the reload — showing a notice instead — whenever it fires.
      //
      // Dirty isn't one-way, though: typing a draft and then clearing it
      // back out leaves nothing to lose either, so every input event
      // re-compares the form's current values against its snapshot at page
      // load and marks clean again when they match — otherwise a tutor who
      // touched the form and backed out would have this tab's live sync
      // stay broken for the rest of its life over a draft that no longer
      // exists. Going clean also has to resolve any reload that was already
      // deferred while dirty — otherwise the stale notice just sits there
      // until some unrelated further change happens to arrive.
      const dirty = createDirtyTracker();
      const rescheduleForm = document.querySelector<HTMLFormElement>('form[action="/api/exceptions"]');
      const serialize = (form: HTMLFormElement) => new URLSearchParams(new FormData(form) as unknown as string[][]).toString();
      const pristineSnapshot = rescheduleForm ? serialize(rescheduleForm) : null;
      rescheduleForm?.addEventListener("input", () => {
        if (serialize(rescheduleForm) === pristineSnapshot) {
          dirty.markClean();
          if (dirty.claimPendingReload()) location.reload();
        } else {
          dirty.markDirty();
        }
      });

      // Preview-only: the server is what actually computes the end time (90
      // minutes after the start), so this can't drift out of sync with what
      // gets saved — it just shows the tutor the range before they submit,
      // since the form itself only asks for a start time.
      const startTimeInput = document.getElementById("startTime") as HTMLInputElement | null;
      const endPreview = document.getElementById("end-preview");
      const updateEndPreview = () => {
        if (!endPreview) return;
        const match = startTimeInput?.value.match(/^(\d{2}):(\d{2})$/);
        if (!match) {
          endPreview.textContent = "";
          return;
        }
        const total = Number(match[1]) * 60 + Number(match[2]) + 90;
        if (total >= 24 * 60) {
          endPreview.textContent = "too late in the day for a 90-minute session";
          return;
        }
        const endH = String(Math.floor(total / 60)).padStart(2, "0");
        const endM = String(total % 60).padStart(2, "0");
        endPreview.textContent = `ends ${endH}:${endM}`;
      };
      startTimeInput?.addEventListener("input", updateEndPreview);
      updateEndPreview();

      const staleNotice = document.getElementById("stale-notice");
      const reloadUnlessDirty = () => {
        if (dirty.isDirty()) {
          dirty.notePendingReload();
          staleNotice?.removeAttribute("hidden");
        } else {
          location.reload();
        }
      };

      const source = new EventSource("/api/events");
      source.addEventListener("message", reloadUnlessDirty);

      // A dropped connection (a network blip, or on Fly.io the machine
      // auto-stopping while idle) reconnects on its own — that's the
      // browser's EventSource doing what the spec says. But any "changed"
      // ping broadcast while disconnected is gone: the in-memory bus keeps
      // no backlog. Reload on every reconnect too (see live-reload.ts), so
      // a tab that missed a change while disconnected still catches up
      // instead of sitting stale until the next one — subject to the same
      // dirty check, for the same reason.
      const shouldReloadOnOpen = createReconnectGate();
      source.addEventListener("open", () => {
        if (shouldReloadOnOpen()) reloadUnlessDirty();
      });
    </script>
  </body>
</html>
